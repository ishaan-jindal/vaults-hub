{
  "name": "vaults-hub",
  "version": "0.2.0",
  "description": "Stdio MCP server for Obsidian-style Markdown vaults",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vaults-hub": "bin/vaults-hub.mjs"
  },
  "files": [
